`verilator_config

lint_off -rule EOFNEWLINE --file "*.v" -match "Missing newline at end of file*"
// Parsing line 2 follows the EOFNEWLINE check at the last line, outside this range.
lint_off -rule DECLFILENAME --file "*/t_lint_eofnewline_bad.v" -lines 2
lint_off -rule BADVLTPRAGMA --file "*/t_lint_eofnewline_sub.v"
lint_off -rule DECLFILENAME --file "*/t_lint_eofnewline_sub.v"
